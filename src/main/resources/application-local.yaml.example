# Local-only overrides (DO NOT COMMIT real secrets)
# Copy this file to `application-local.yaml` and fill in your values.
# `application-local.yaml` is ignored by git.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/hotel_reservation_premium?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Bangkok
    username: root
    password: 123456

jwt:
  secret: hotel_reservation_secret_key_change_me_to_a_long_random_string
  expiration: 86400000
